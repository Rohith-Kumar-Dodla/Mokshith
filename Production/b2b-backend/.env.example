# =============================================================================
# Mokshith Enterprises B2B Backend — Environment Configuration
# Copy this file to .env and fill in real values before running the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# Preferred: mongodb+srv://... (Atlas SRV). If you see "querySrv ECONNREFUSED",
# use Atlas "Standard connection string" (mongodb://...) in MONGO_URI_DIRECT instead.
# MONGO_URI=mongodb://localhost:27017/b2b-ecommerce
# MONGO_URI=<your_mongodb_connection_string_here>
# Example (Atlas): mongodb+srv://USER:PASS@cluster0.mongodb.net/your_db?retryWrites=true&w=majority

# Dev only: use embedded MongoDB when local mongod is not installed (data resets on restart)
# USE_IN_MEMORY_MONGO=true
# MONGO_URI_DIRECT=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/b2b-ecommerce?ssl=true&authSource=admin&replicaSet=...

# -----------------------------------------------------------------------------
# Authentication (Required)
# JWT_SECRET must be at least 64 characters in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-64-character-or-longer-secret-key-for-development-only
JWT_REFRESH_SECRET=replace-with-another-64-character-or-longer-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Razorpay Payments (Optional — required only for online/UPI/hybrid checkout)
# COD, credit, and bank transfer work without these.
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# Redis (Required for cache, queues, rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Optional: Socket.IO Redis Adapter
# -----------------------------------------------------------------------------
USE_SOCKET_REDIS_ADAPTER=false

# -----------------------------------------------------------------------------
# Cloudinary Image Storage (Recommended)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=ddce7o0qw
CLOUDINARY_API_KEY=694653733292475
CLOUDINARY_API_SECRET=reyszu4NOGOoslr903XU5lGndSU

# -----------------------------------------------------------------------------
# Optional: AWS S3 File Storage
# -----------------------------------------------------------------------------
USE_S3_STORAGE=false
S3_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your_aws_access_key
S3_SECRET_ACCESS_KEY=your_aws_secret_key

# -----------------------------------------------------------------------------
# Optional: Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Optional: Monitoring & Logging
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
ENABLE_FILE_LOGGING=false

# -----------------------------------------------------------------------------
# Optional: Background Jobs & Workers
# -----------------------------------------------------------------------------
ENABLE_QUEUE=true
ENABLE_WORKERS=true
ENABLE_CRON=true

# -----------------------------------------------------------------------------
# Optional: Feature Flags
# -----------------------------------------------------------------------------
ENABLE_MAINTENANCE_MODE=false
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOGS=true
ENABLE_REGISTRATIONS=true

# Auth validation: true = production policy, false = UAT/testing (6-char passwords)
# RE-ENABLE BEFORE PRODUCTION: set AUTH_STRICT_MODE=true
# When false, auth rate limits and fraud login/register blocks are also disabled.
AUTH_STRICT_MODE=false

# -----------------------------------------------------------------------------
# Optional: Encryption
# -----------------------------------------------------------------------------
ENCRYPTION_SECRET=replace-with-encryption-secret
# Optional: Monitoring alert webhook (POSTs JSON alerts)
MONITORING_ALERT_WEBHOOK=
