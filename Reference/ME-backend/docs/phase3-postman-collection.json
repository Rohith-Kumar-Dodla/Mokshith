        {
          "name": "TEST 1: Admin Creates Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has success: true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "pm.test(\"Category created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.name).to.eql(\"Soft Drinks\");",
                  "    pm.expect(jsonData.data.slug).to.eql(\"soft-drinks\");",
                  "    pm.expect(jsonData.data.status).to.eql(\"active\");",
                  "    pm.collectionVariables.set(\"categoryId\", jsonData.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Soft Drinks\",\n  \"description\": \"Carbonated and non-carbonated beverages\",\n  \"image\": \"https://example.com/soft-drinks.jpg\",\n  \"status\": \"active\",\n  \"sortOrder\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
