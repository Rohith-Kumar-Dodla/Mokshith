# =================================================================
# B2B Frontend Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual values
# Vite requires VITE_ prefix for all environment variables
# =================================================================

# Backend API URL
VITE_API_URL=http://localhost:5000
# Production: https://your-backend-domain.onrender.com

# WebSocket URL (usually same as API URL)
VITE_SOCKET_URL=http://localhost:5000
# Production: https://your-backend-domain.onrender.com

# Razorpay Public Key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
# This is the PUBLIC key, not the secret

# =================================================================
# Optional Configuration
# =================================================================

# Analytics (if using)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# Feature Flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_CHAT=true