# Environment Configuration Template
# Copy this to .env and fill in your values

# ==============================================
# APPLICATION
# ==============================================
NODE_ENV=production
PORT=5000

# ==============================================
# DATABASE
# ==============================================
MONGO_URI=mongodb://localhost:27017/b2b-ecommerce
# For replica set (transactions): mongodb://localhost:27017,localhost:27018,localhost:27019/b2b-ecommerce?replicaSet=rs0

# MongoDB Read Replica Configuration
MONGO_READ_PREFERENCE=primaryPreferred
# Options: primary, primaryPreferred, secondary, secondaryPreferred, nearest
MONGO_WRITE_CONCERN=majority
# Options: majority, 1, 2, 3 (number of nodes)

# MongoDB Performance
MONGODB_PROFILING=false
# Enable query profiling for performance monitoring

# ==============================================
# AUTHENTICATION
# ==============================================
# CRITICAL: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 64 characters in production
JWT_SECRET=your-super-long-jwt-secret-at-least-64-characters-long-generated-securely
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-also-64-chars-minimum
REFRESH_TOKEN_EXPIRES_IN=7d

# ==============================================
# PAYMENT GATEWAY (RAZORPAY)
# ==============================================
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ==============================================
# REDIS (CACHING & QUEUES)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=optional_password
# REDIS_URL=redis://localhost:6379 (alternative to host/port)

# Socket.IO Redis Adapter (for horizontal scaling)
USE_SOCKET_REDIS_ADAPTER=false
# Set to 'true' in production with multiple server instances

# ==============================================
# QUEUES & JOBS
# ==============================================
ENABLE_QUEUE=true
ENABLE_CRON=true

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info
ENABLE_FILE_LOGGING=true

# ==============================================
# ERROR TRACKING (SENTRY)
# ==============================================
# Get DSN from: https://sentry.io/
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ==============================================
# FRONTEND
# ==============================================
FRONTEND_URL=https://your-frontend-domain.com

# ==============================================
# CORS
# ==============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com

# ==============================================
# FILE UPLOADS
# ==============================================
MAX_FILE_SIZE=10485760
# 10MB in bytes (10 * 1024 * 1024)

# ==============================================
# CLOUD STORAGE (S3 / DigitalOcean Spaces / MinIO)
# ==============================================
USE_S3_STORAGE=false
# Set to 'true' to use cloud storage instead of local filesystem

# AWS S3 Configuration
S3_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# For S3-compatible services (DigitalOcean Spaces, MinIO, etc.)
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_FORCE_PATH_STYLE=true

# CDN Configuration (optional)
S3_CDN_URL=https://cdn.yourdomain.com
# Use CDN in front of S3 for better performance

# ==============================================
# CDN & ASSET DELIVERY
# ==============================================
CDN_URL=https://cdn.yourdomain.com
CDN_IMAGE_OPTIMIZATION=false
# Enable if using Cloudflare Images, Imgix, or similar

# CDN Cache Purging (optional)
CDN_PURGE_ENABLED=false
CDN_PROVIDER=cloudflare
# Options: cloudflare, fastly, akamai
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-api-token

BACKEND_URL=http://localhost:5000

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# OPTIONAL: THIRD-PARTY SERVICES
# ==============================================
# SMS_API_KEY=your_sms_api_key
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_email_password

# ==============================================
# DEVELOPMENT ONLY
# ==============================================
# Uncomment for debugging
# DEBUG=true
# VERBOSE_LOGGING=true
