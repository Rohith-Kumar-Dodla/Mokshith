# =================================================================
# B2B Backend Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/mokshith-entreprises
# Production: mongodb+srv://<username>:<password>@cluster.mongodb.net/mokshith-entreprises?retryWrites=true&w=majority

# JWT Authentication (REQUIRED - Use strong secrets in production)
JWT_SECRET=change_this_to_a_strong_random_secret_minimum_32_characters_long
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRE=7d

# Payment Gateway - Razorpay (REQUIRED)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email/SMTP Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@mokshith-entreprises.com

# Redis Configuration (Optional but recommended for production)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Production: Use Redis Cloud or managed Redis service

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Production: https://your-frontend-domain.vercel.app

# Sentry Error Tracking (Optional)
# SENTRY_DSN=your_sentry_dsn

# File Upload Limits
MAX_FILE_SIZE=5242880
# 5MB = 5 * 1024 * 1024

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================================================
# Docker-specific (when running in containers)
# =================================================================
# MONGO_URI=mongodb://mongo:27017/mokshith-entreprises
# REDIS_HOST=redis
# REDIS_PORT=6379
