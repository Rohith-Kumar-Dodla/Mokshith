{
  "name": "b2b-backend",
  "version": "1.0.0",
  "description": "B2B + B2C E-commerce Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . || echo 'ESLint not configured'",
    "lint:fix": "eslint . --fix || echo 'ESLint not configured'",
    "format": "prettier --write . || echo 'Prettier not configured'",
    "format:check": "prettier --check . || echo 'Prettier not configured'",
    "docker:build": "docker build -t b2b-backend:latest .",
    "docker:run": "docker run -p 5000:5000 --env-file .env b2b-backend:latest",
    "docker:dev": "docker-compose up -d mongo redis && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.41.6",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "otp-generator": "^4.0.1",
    "pdfkit": "^0.18.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0"
  }
}
