# Environment Configuration
# Copy this file to .env.local and fill in your values

# =========================
# API Configuration
# =========================
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# =========================
# Sentry Configuration
# =========================
# Get your DSN from https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
VITE_SENTRY_DSN=your-sentry-dsn-here

# Environment (development, staging, production)
VITE_ENVIRONMENT=production

# Application version for release tracking
VITE_RELEASE=1.0.0

# Enable Sentry in development (optional, default: false)
# VITE_SENTRY_DEV=true

# =========================
# Payment Gateway
# =========================
VITE_RAZORPAY_KEY_ID=your-razorpay-key-here

# =========================
# Feature Flags
# =========================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# =========================
# Deployment
# =========================
VITE_APP_NAME=B2B Enterprise Platform
VITE_APP_URL=https://yourdomain.com
